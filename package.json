{
  "name": "moamoa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist --project-name moamoa --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.138",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.1",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "pretendard": "^1.3.9"
  }
}
